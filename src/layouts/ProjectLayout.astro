---
import BaseLayout from '../layouts/BaseLayout.astro';
const { frontmatter } = Astro.props; 
---

<BaseLayout title={ frontmatter.title }> 
    <h1>{ frontmatter.title }</h1>
    <section class="box">
        <h2>Description</h2>
        <p class="desc">{ frontmatter.description }</p>
    </section>
    
    {(frontmatter.source || frontmatter.game || frontmatter.cad) && (
        <section class="box links">
        <h2>Relevant Links</h2>
        <p>Source Code: <a href={frontmatter.source} target="_blank" rel="noopener noreferrer">{frontmatter.source}</a></p>
        {frontmatter.game && <p>Game: <a href={frontmatter.game} target="_blank" rel="noopener noreferrer">{frontmatter.game}</a></p>}
        {frontmatter.cad && <p>STEP Files: <a href={frontmatter.cad} target="_blank" rel="noopener noreferrer">{frontmatter.cad}</a></p>}
        </section>
    )}

    {frontmatter.demo && (
        <section class="box demo">
        <h2>Demo Video:</h2>
        <iframe
            class="video"
            src={ `https://www.youtube.com/embed/${frontmatter.demo}` }
            title={`${frontmatter.title} Demo`}
            allowfullscreen
        ></iframe>
        </section> 
    )}

    <section class="box dev">
        <h2>Development Process</h2>
        <slot /> 
    </section>
</BaseLayout>

<style>
    main { 
        padding: 0 1rem;
    }
    h1 { 
        text-align: center; 
        font-size: 3rem;
    }
    .box { 
        text-align: left; 
    }
    .dev :global(img) { 
        max-width: 100%; 
        border-radius: 4px; 
    }
    .video { 
        width: 100%;
        aspect-ratio: 16/9; 
        border: none; 
        border-radius: 4px;
    }
    .desc {
        white-space: pre-line;
    }
</style>